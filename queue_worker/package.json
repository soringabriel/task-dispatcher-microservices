{
  "name": "queue_worker",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp -r ./src/proto ./dist/proto",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "proto": "grpc_tools_node_protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:src/proto --js_out=import_style=commonjs,binary:src/proto --grpc_out=grpc_js:src/proto --proto_path=src/proto src/proto/job.proto"
  },
