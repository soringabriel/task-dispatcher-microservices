  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@grpc/proto-loader": "^0.7.15",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.15.3",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.3",
    "dotenv": "^16.5.0",
    "kafkajs": "^2.2.4"
  }
